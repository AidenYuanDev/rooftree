# What this configuration builds, once configured

function(rooftree_summary_line label value)
  if(value)
    set(value "yes")
  else()
    set(value "no")
  endif()
  string(LENGTH "${label}" length)
  math(EXPR padding "24 - ${length}")
  string(REPEAT " " ${padding} spaces)
  message("  ${label}${spaces}${value}")
endfunction()

message("")
