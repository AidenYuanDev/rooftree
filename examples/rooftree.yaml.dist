############################################
# Rooftree examples configuration file #
############################################

###################################################################################################
# SECTION INDEX
#
#    EXAMPLE CONFIG
#    LOGGING SYSTEM SETTINGS
#    ECHO SERVER SETTINGS
#    HTTP SERVER SETTINGS
#    DATABASE SETTINGS
#
###################################################################################################

###################################################################################################
# EXAMPLE CONFIG
#
#    Variable
#        Description: Brief description what the variable is doing.
#        Important:   Annotation for important things about this variable.
#        Example:     "Example, i.e. if the value is a string"
#        Default:     10 - (Enabled|Comment|Variable name in case of grouped config options)
#                     0  - (Disabled|Comment|Variable name in case of grouped config options)
#
#    Every variable can be overridden by an environment variable, read when the file is loaded:
#    prefix ROOFTREE_, dots become underscores, all upper case. Example: Echo.Port -> ROOFTREE_ECHO_PORT
#
# Note to developers:
# - Copy this example to keep the formatting.
# - Line breaks should be at column 100.
###################################################################################################

###################################################################################################
# LOGGING SYSTEM SETTINGS
#
#    LogsDir
#        Description: Logs directory setting.
#        Important:   LogsDir needs to be quoted, as the string might contain space characters.
#                     Logs directory must exist, or log file creation will be disabled.
#        Default:     "" - (Log files will be stored in the current path)

LogsDir: ""

#
#  Appender config values: Given an appender "name"
#    Appender.name
#        Description: Defines 'where to log'.
#        Important:   One line "Type,LogLevel,Flags,optional1,optional2,optional3" works too,
#                     e.g. Console: "1,3,7,9 1 8 2 6 7" (see src/common/log/LogConfig.h).
#        Format:      Type, Level, Flags, then the values of its type
#
#                     Type
#                         1 - (Console)
#                         2 - (File)
#                         3 - (DB)
#                             (needs AppenderDB registered, see src/database/AppenderDB.h)
#
#                     Level
#                         0 - (Disabled)
#                         1 - (Trace)
#                         2 - (Debug)
#                         3 - (Info)
#                         4 - (Warn)
#                         5 - (Error)
#                         6 - (Fatal)
#
#                     Flags
#                         0 - None
#                         1 - Prefix Timestamp to the text
#                         2 - Prefix Log Level to the text
#                         4 - Prefix Log Filter type to the text
#                         8 - Append timestamp to the log file name. Format: YYYY-MM-DD_HH-MM-SS
#                             (Only used with Type = 2)
#                        16 - Make a backup of existing file before overwrite
#                             (Only used with Mode = w)
#
#                     Colors (only used with Type = 1)
#                         Format: [fatal, error, warn, info, debug, trace]
#                         0 - BLACK
#                         1 - RED
#                         2 - GREEN
#                         3 - BROWN
#                         4 - BLUE
#                         5 - MAGENTA
#                         6 - CYAN
#                         7 - GREY
#                         8 - YELLOW
#                         9 - LRED
#                        10 - LGREEN
#                        11 - LBLUE
#                        12 - LMAGENTA
#                        13 - LCYAN
#                        14 - WHITE
#                         Example: [13, 11, 9, 5, 3, 1]
#
#                     File: Name of the file (only used with Type = 2)
#                         Allows to use one "%s" to create dynamic files
#
#                     Mode: Mode to open the file (only used with Type = 2)
#                         a - (Append, default)
#                         w - (Overwrite)
#
#                     MaxSize: Maximum file size of the log file before creating a new log file
#                     (only used with Type = 2)
#                         Size is measured in bytes expressed in a 32-bit unsigned integer.
#                         Maximum value is 4294967295 (4 GB). Leave out for no limit.
#                         NOTE: Does not work with dynamic filenames.
#                         Example:  536870912 (512 MB)
#
#                     Args: Optional arguments of a custom appender type, in order
#                         Example: [arg1, arg2]
#

Appender:
  Console:
    Type: 1
    Level: 3
    Flags: 7
    Colors: [9, 1, 8, 2, 6, 7]
  # Server:
  #   Type: 2
  #   Level: 2
  #   Flags: 7
  #   File: Server.log
  #   Mode: w

#  Logger config values: Given a logger "name"
#    Logger.name
#        Description: Defines 'What to log'
#        Important:   Lookup is hierarchical: "server.http.session" falls back to "server.http",
#                     "server", then "root". Names containing dots are written as one key
#                     (server.http:), not as nested mappings.
#        Format:      Level, Appenders
#
#                     Level
#                         0 - (Disabled)
#                         1 - (Trace)
#                         2 - (Debug)
#                         3 - (Info)
#                         4 - (Warn)
#                         5 - (Error)
#                         6 - (Fatal)
#
#                     Appenders: List of appenders linked to logger
#                         Example: [Console, Server]
#
#    Every line is written and flushed immediately. For asynchronous logging pass an io_context to
#    sLog->Initialize() instead of calling sLog->LoadFromConfig().
#

Logger:
  root:
    Level: 3
    Appenders: [Console]
  server.http:
    Level: 2
    Appenders: [Console]

#
###################################################################################################

###################################################################################################
# ECHO SERVER SETTINGS
#
#    Echo.BindIP
#        Description: Bind echo_server to IP/hostname.
#        Default:     "0.0.0.0" - (Bind to all IPs on the system)

#
#    Echo.Port
#        Description: TCP port to reach the echo server.
#        Default:     7000

#
#    Echo.NetworkThreads
#        Description: Number of threads for network.
#        Default:     2

Echo:
  BindIP: "0.0.0.0"
  Port: 7000
  NetworkThreads: 2

#
###################################################################################################

###################################################################################################
# HTTP SERVER SETTINGS
#
#    Http.BindIP
#        Description: Bind http_server to IP/hostname.
#        Default:     "0.0.0.0" - (Bind to all IPs on the system)

#
#    Http.Port
#        Description: TCP port to reach the http server.
#        Default:     8080

#
#    Http.NetworkThreads
#        Description: Number of threads for network.
#        Default:     1

Http:
  BindIP: "0.0.0.0"
  Port: 8080
  NetworkThreads: 1

#
###################################################################################################

###################################################################################################
# DATABASE SETTINGS
#
#  Database config values: Given a database "name" (db_query uses Demo)
#    Database.name
#        Description: Connection and connection pool settings of a database.
#        Important:   Host, User and Name are required, without them db_query logs an error and
#                     exits. Every value can be overridden on its own,
#                     e.g. ROOFTREE_DATABASE_DEMO_PASSWORD.
#
#                     Host: Hostname or IP address of the PostgreSQL server
#
#                     Port: TCP port of the PostgreSQL server
#                         Default: 5432
#
#                     Socket: Connect through this Unix socket (Windows: named pipe) instead of
#                     Host and Port
#                         Example: "/run/postgresql"
#                         Default: "" - (Use Host and Port)
#
#                     User, Password: Account to log in with
#
#                     Name: Database (schema) to use
#
#                     Ssl: Encryption of the connection
#                         true  - (Required)
#                         false - (Disabled)
#                         Default: left out - (The client library's default)
#
#                     WorkerThreads: Number of asynchronous connections (Execute, AsyncQuery)
#                         Default: 1
#
#                     SynchThreads: Number of synchronous connections (Query, DirectExecute)
#                         Default: 1
#

Database:
  Demo:
    Host: ""
    Port: 5432
    User: ""
    Password: ""
    Name: ""
    WorkerThreads: 2
    SynchThreads: 1

#
###################################################################################################
