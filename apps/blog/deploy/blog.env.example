# /etc/blog/blog.env, readable by root and blog only (chmod 640). Overrides blog.yaml: ROOFTREE_ + the path
# in upper case with dots as underscores
ROOFTREE_DATABASE_BLOG_PASSWORD=change-me
ROOFTREE_BLOG_MAIL_PASSWORD=change-me
# GitHub and Google logins, when Blog.OAuth has their client ids
#ROOFTREE_BLOG_OAUTH_GITHUB_CLIENTSECRET=
#ROOFTREE_BLOG_OAUTH_GOOGLE_CLIENTSECRET=
# For dbmate (blog.service runs the migrations before starting)
# compose.yaml's PostgreSQL listens on 5433, one installed on the host usually on 5432
DATABASE_URL=postgres://blog:change-me@127.0.0.1:5433/rooftree_blog?sslmode=disable
# For rebuild.sh, which the server runs: where the site goes, its public address, and the API to read
# the posts from (Server.Http on port 80, 127.0.0.1 isn't redirected to https)
SITE_DIR=/srv/blog/site
BLOG_PUBLIC_ORIGIN=https://blog.example.com
BLOG_API_URL=http://127.0.0.1
