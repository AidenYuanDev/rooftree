// The arena's messages, both ways. A native client (KCP, or the WebSocket with format=packets) sends
// and gets packets: Packet.h's 8 byte header ([uint16 opcode][uint16 flags = 0][uint32 requestId = 0],
// little-endian) and the opcode's table. The browser page speaks JSON: {"type": name, ...the table's
// fields}, converted at the WebSocket by this schema (ArenaPackets.cpp names the types).
//
// Fields are only added at the end, an opcode keeps its number. Client opcodes are 0x00xx, the
// server's 0x01xx; 0 is the framework's Error, unused here.

namespace Arena;

enum Opcode : ushort {
  // Client to server
  Ping = 0x0001,
  Input = 0x0002,
  Chat = 0x0003,
  SetTarget = 0x0004,
  CastSpell = 0x0005,
  CancelCast = 0x0006,
  Attack = 0x0007,

  // Server to client
  Welcome = 0x0101,
  Pong = 0x0102,
  // 0x0103 was State, everything about the players it saw every tick: Frame and Units since
  ChatMessage = 0x0104,
  SystemMessage = 0x0105,
  Spells = 0x0106,
  CastFailed = 0x0107,
  CombatLog = 0x0108,
  Frame = 0x0109,
  Units = 0x010A,
}

// combat/Unit.h's CastResult, same values
enum CastError : ubyte {
  Ok,
  UnknownSpell,
  Dead,
  Casting,
  Stunned,
  Moving,
  NotReady,
  NoMana,
  NoTarget,
  TargetDead,
  BadTarget,
  OutOfRange,
  NoComboPoints,
}

// combat/Unit.h's InterruptReason, same values
enum InterruptReason : ubyte {
  None,
  Cancelled,
  Moved,
  Stunned,
  Died,
  TargetLost,
  OutOfRange,
}

// combat/CombatMap.h's CombatEventType, same values
enum CombatEventType : ubyte {
  CastStart,
  SpellGo,
  CastInterrupted,
  Damage,
  Heal,
  AuraApplied,
  AuraRemoved,
  Death,
  Swing,
}

enum SpellTargetType : ubyte {
  Enemy,
  Self,
}

// combat/SpellInfo.h's UnitClass and PowerType, same values. The login's "class" picks one
enum PlayerClass : ubyte {
  Adventurer,
  Rogue,
}

enum PowerType : ubyte {
  Mana,
  Energy,
}

// ---- client to server ---------------------------------------------------------------------------

// Any time, answered with a Pong of the same t: the client's clock, for its round trip time
table Ping {
  t:double;
}

// In game: where the player walks until the next one. x, y: any direction, its length doesn't matter;
// without them (both 0) dx, dy: -1, 0 or 1 each (others are clamped). facing: where the player looks,
// radians in the field's axes (0 along +x, y down), shown to others; without it the way it walks
table Input {
  dx:byte;
  dy:byte;
  x:float;
  y:float;
  facing:float = nan;
}

// In game: a line for everyone, at most Arena.Chat.MaxLength characters and one per Arena.Chat.Interval
table Chat {
  text:string;
}

// In game: what the player looks at, shown to everyone; 0 for nothing. An id that isn't a unit is 0
table SetTarget {
  id:uint;
}

// In game: cast a spell of the Spells list at a unit (ignored by spells at the caster itself). A
// refusal is answered with a CastFailed of the same castId, which is the client's own number
table CastSpell {
  spell:uint;
  target:uint;
  castId:uint;
}

// In game: stop the spell being cast, if any
table CancelCast {
}
// In game: attack a unit with weapon swings until told otherwise (0) or it dies: one every few seconds
// while it is in melee range, none while casting or stunned. A unit that can't be attacked is ignored;
// UnitInfo.attackTarget says what is attacked
table Attack {
  target:uint;
}

// ---- server to client ---------------------------------------------------------------------------

// Once the player is loaded: inputs and chat are accepted from now on
table Welcome {
  id:uint;
  name:string;
  width:float;
  height:float;
  playerRadius:float;
  totalCoins:uint;
  motd:string;
  playerClass:PlayerClass;
  power:PowerType;
}

table Pong {
  t:double;
}

// What changes all the time of a unit the player sees: in every Frame. A struct, with no field
// offsets, so that 30 of them and the coins go in one datagram (KCP's MaxBodySize, 1171 bytes)
struct UnitMotion {
  id:uint;
  x:float;
  y:float;
  facing:float; // radians, see Input
  health:uint;  // 0: dead, back in Arena.Combat.RespawnTime
  mana:uint;    // of its power, UnitInfo.power
}

struct CoinSpot {
  id:uint;
  x:float;
  y:float;
  value:uint;
}

// Every world tick to everyone in game, unreliably over KCP: the next one replaces a lost one. The
// units the player sees, itself too (Arena.World.ViewDistance, the nearest Arena.World.MaxVisible),
// and the coins in that range. A unit's other fields come in Units, which may arrive after the first
// Frame that has it
table Frame {
  tick:uint;            // one more each world update: one older than the last that came is stale
  units:[UnitMotion];
  coins:[CoinSpot];
  goldRush:bool;
}

// What changes now and then of a unit the player sees
table UnitInfo {
  id:uint;
  name:string;
  maxHealth:uint;
  maxMana:uint;
  power:PowerType;    // what mana and maxMana are
  playerClass:PlayerClass;
  target:uint;        // SetTarget's
  attackTarget:uint;  // Attack's, 0 when not attacking
  comboPoints:ubyte;
  speed:float;        // walking now, per second: Arena.World.PlayerSpeed times its boosts
  score:uint;         // this session's coins
  total:uint;         // all time
  kills:uint;         // this session's
  deaths:uint;
}

// Reliably and in order, before the tick's Frame: all of a unit's UnitInfo when the player starts
// seeing it or any of it changed, and the units it stopped seeing (their info is sent again when they
// come back). What a client keeps of a unit lives from its info to its gone
table Units {
  units:[UnitInfo];
  gone:[uint];
}

table ChatMessage {
  from:string;
  text:string;
}

// From the server: joins, leaves, gold rush, chat refused, who killed whom
table SystemMessage {
  text:string;
}

table SpellData {
  id:uint;
  name:string;
  target:SpellTargetType;
  castTime:uint;    // ms, 0 for an instant
  cooldown:uint;    // ms, starts when the cast completes
  gcd:bool;         // starts the global cooldown when the cast starts
  manaCost:uint;    // spent when the cast completes, of the caster's power
  range:float;      // between the two players' edges: 0 when they touch
  finisher:bool;    // needs a combo point, spends them all, does more for each
}

// After Welcome: the spells the player's class has, in the bar's order
table Spells {
  spells:[SpellData];
  globalCooldown:uint;  // ms
}

// To the caster: a CastSpell refused, nothing started
table CastFailed {
  castId:uint;
  spell:uint;
  error:CastError;
}

// What one unit did to another, see combat/CombatMap.h's CombatEventType for the fields each type has.
// Swing: an auto attack's blow, its Damage (spell 0) follows
table CombatEvent {
  type:CombatEventType;
  caster:uint;      // Death: the killer
  target:uint;
  spell:uint;       // the aura's id for auras and periodic damage
  amount:uint;
  duration:uint;    // ms
  crit:bool;
  periodic:bool;
  reason:InterruptReason;
}

// Every world tick that had any, to everyone in game, reliably and in order: a lost one would
// lose a death or a heal
table CombatLog {
  events:[CombatEvent];
}

// Any of the tables would do: flatc embeds a binary schema (Arena_bfbs_generated.h, FlatJsonSchema's)
// only for a schema with a root type, named after it (FrameBinarySchema). Packets say their table by
// the opcode, not this
root_type Frame;
